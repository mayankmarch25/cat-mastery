{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CAT Mastery question",
  "type": "object",
  "required": ["id", "section", "type", "topic", "question"],
  "properties": {
    "id": { "type": "string" },
    "section": { "enum": ["QA", "DILR", "VARC"] },
    "type": { "enum": ["MCQ", "TITA"] },
    "topic": { "type": "string" },
    "difficulty": { "type": "string" },
    "sourceType": { "enum": ["PYQ", "ORIGINAL", "RECONSTRUCTED", "EXTERNAL"] },
    "sourceLabel": { "type": "string" },
    "sourceUrl": { "type": "string" },
    "year": { "type": ["integer", "null"] },
    "slot": { "type": ["integer", "null"] },
    "title": { "type": "string" },
    "stimulus": { "type": "string", "description": "Passage or caselet. Questions sharing a stimulus are treated as one set." },
    "question": { "type": "string" },
    "options": { "type": "array", "items": { "type": "string" }, "minItems": 4 },
    "answer": { "type": "integer", "description": "Index into options. Must match answerText." },
    "answerText": { "type": "string" },
    "explanation": { "type": "string" },
    "explanationStatus": { "enum": ["FULL", "KEY_ONLY"], "description": "KEY_ONLY means the source gave an answer key but no worked solution." },
    "howToThink": { "type": "string" },
    "verifiedAnswer": { "type": "boolean", "description": "True when computed at build time, taken from a matching published key, or authored with a full explanation." },
    "answerSource": { "type": "string" }
  }
}
